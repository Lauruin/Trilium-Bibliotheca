{
  "name": "trilium-bibliotheca",
  "description": "Your Trilium vault as a walkable pixel-art library. Standalone React + Phaser web app talking to Trilium's ETAPI.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "bash tools/check.sh",
    "seed:vault": "node tools/seed-vault.js",
    "mock:fake": "node tools/etapi-fake.mjs",
    "test:mock": "node tools/mock-test.mjs"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "1.49.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
