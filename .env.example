# Optional first-run defaults for the settings dialog (copy to .env.local, used by `npm run dev` only).
# Never put a real token in a committed file, and NEVER put a token in a VITE_* variable for a hosted build:
# every VITE_* value is baked into the JavaScript bundle that every visitor downloads. For hosting use the
# server-side variables below instead (the token then stays in the container and never reaches a browser).
VITE_TRILIUM_URL=http://localhost:8080
VITE_TRILIUM_TOKEN=

# --- HOSTED MODE (docker compose; put these in a file called `.env` next to compose.yml, NOT .env.local) ---
# nginx proxies /etapi/ to your Trilium on the app's own origin and adds the token itself.
# BIBLIO_TRILIUM_URL=http://trilium:8080
# BIBLIO_TRILIUM_TOKEN=
# BIBLIO_TRILIUM_READONLY=1
# BIBLIO_TRILIUM_ROOT_NOTE_ID=root
# BIBLIO_TRILIUM_NAME=My notes
# BIBLIO_TRILIUM_PUBLIC_URL=https://trilium.example.com
# AI for quizzes (optional; off unless set). A small local model works: provider openai-compatible + an Ollama URL.
# BIBLIO_AI_PROVIDER=anthropic
# BIBLIO_AI_BASE_URL=
# BIBLIO_AI_KEY=
# BIBLIO_AI_MODEL=claude-haiku-5-5
